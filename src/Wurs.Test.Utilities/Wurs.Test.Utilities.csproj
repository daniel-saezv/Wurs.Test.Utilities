<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Description>Test utilities for fluent HttpMessageHandler response setup and IHttpClientFactory helpers.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>testing;httpclient;httpmessagehandler;ihttpclientfactory;dotnet</PackageTags>
		<RepositoryUrl>https://github.com/daniel-saezv/Wurs.Test.Utilities</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Deterministic>true</Deterministic>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Wurs.Test.Utilities.Moq</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Wurs.Test.Utilities.NSubstitute</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Wurs.Test.Utilities.UnitTest\**\*.cs" />
		<EmbeddedResource Remove="Wurs.Test.Utilities.UnitTest\**\*" />
		<None Remove="Wurs.Test.Utilities.UnitTest\**\*" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
	</ItemGroup>

</Project>