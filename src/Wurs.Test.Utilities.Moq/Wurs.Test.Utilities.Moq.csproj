<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
        <Description>Moq integration helpers for Wurs.Test.Utilities HttpMessageHandler and IHttpClientFactory test setup.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>testing;httpclient;httpmessagehandler;ihttpclientfactory;moq;dotnet</PackageTags>
        <RepositoryUrl>https://github.com/daniel-saezv/Wurs.Test.Utilities</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Wurs.Test.Utilities.UnitTest</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wurs.Test.Utilities\Wurs.Test.Utilities.csproj" />
  </ItemGroup>

</Project>
